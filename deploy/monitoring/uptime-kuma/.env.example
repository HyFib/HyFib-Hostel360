# Settings of the external monitor stack (copy to .env next to compose.yml, chmod 0600).

# DNS name of this monitor VM; Caddy obtains its certificate for it
MONITOR_HOSTNAME=monitor.hyfib.com

# Ingest relay: the Hostel360 ingest API, reached through the public load balancer
H360_INGEST_URL=https://hostel.accet.ac.in/api/method/hostel360.api.ops.ingest
# Host label on the relayed samples
H360_RELAY_HOST=uptime-kuma-mumbai
# Uptime Kuma monitor whose results are relayed (deploy/monitoring/README.md)
KUMA_MONITOR=Portal readiness
# One reading a minute; samples go five at a time, or at once when the status changes
RELAY_INTERVAL_SECONDS=60
RELAY_BATCH=5
# Readings kept while the portal cannot take them
RELAY_SPOOL_KEEP_DAYS=35
RELAY_SPOOL_MAX_FILES=12000
