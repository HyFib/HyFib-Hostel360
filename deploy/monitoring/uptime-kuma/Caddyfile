# Public face of the external monitor: only Uptime Kuma's push endpoint, over HTTPS.
{$MONITOR_HOSTNAME} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	@push path /api/push/*
	handle @push {
		reverse_proxy uptime-kuma:3001
	}

	handle {
		respond "Not found" 404
	}
}
