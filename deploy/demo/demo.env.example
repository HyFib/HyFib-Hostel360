# HyFib Hostel360 public demo: settings for deploy/demo/up.sh.
#
# up.sh copies this file to ~/hostel360-demo/demo.env (H360_DEMO_HOME) on its first run;
# edit that copy. No secrets belong here: the database and Administrator passwords are
# random ones in ~/hostel360-demo/config/secrets/, and the tunnel's credentials stay in
# ~/.cloudflared/. Paths, the image tag and the WAF's trusted address are worked out by
# up.sh (config/runtime.env), not set here.

# Site served by the demo and its public address (the tunnel's DNS name)
SITE_NAME=hostel360.hyfib.com
PUBLIC_URL=https://hostel360.hyfib.com

# Cloudflare named tunnel, created once with "cloudflared tunnel create hostel360-demo"
# (deploy/demo/README.md). The id is the UUID that command prints; empty runs the stack
# without the tunnel, reachable on this Mac only.
TUNNEL_ID=
# Its credentials file; empty means ~/.cloudflared/<TUNNEL_ID>.json
CLOUDFLARED_CREDENTIALS_FILE=

# Address and host ports of the WAF on this Mac, for local checks. Loopback only: visitors
# come through the tunnel, never over the LAN (up.sh refuses any other address).
WAF_BIND_ADDRESS=127.0.0.1
WAF_HTTP_PORT=18080
WAF_HTTPS_PORT=18443

# Container networks, chosen clear of the other stacks on this Docker Desktop. The tunnel has
# a fixed address on the edge network; it must lie inside H360_EDGE_SUBNET, and it is the
# only address the WAF accepts X-Forwarded-For from.
H360_EDGE_SUBNET=172.30.120.0/24
H360_TUNNEL_IP=172.30.120.250
H360_INTERNAL_SUBNET=172.30.110.0/24
H360_PHP_SUBNET=172.30.130.0/24

# Demo data for "bench h360-demo-site": number of students and the random seed (same seed,
# same data). Empty uses the command's defaults.
DEMO_STUDENTS=
DEMO_SEED=

# Nightly rebuild from the golden snapshot, Asia/Kolkata time (HH:MM)
DEMO_RESET_AT=02:30

# Gunicorn: 3 workers x 4 threads (production: 6 x 4)
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# WAF: blocking mode and the per-address sign-in limits, as in production
WAF_RULE_ENGINE=On
WAF_AUTH_RATE=120r/m
WAF_AUTH_BURST=60
WAF_LOGIN_RATE=30r/m
WAF_LOGIN_BURST=20

# Hostel website integration pages (/integration/)
INSTITUTION_NAME=Alagappa Chettiar Government College of Engineering and Technology Hostels
INSTITUTION_SHORT_NAME=ACGCET
SUPPORT_PHONE=+91 96060 60596
SUPPORT_EMAIL=support@hyfib.com
HOSTEL_WEBSITE_ORIGINS=https://www.accet.ac.in
