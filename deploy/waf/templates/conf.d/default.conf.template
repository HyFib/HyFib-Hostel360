# HyFib Hostel360 edge server: OCI Load Balancer -> this WAF -> frontend nginx.
#
# Replaces the image's default server. Two listeners serve the same site:
#   ${SSL_PORT}  TLS with the internal certificate; the load balancer re-encrypts to it
#   ${PORT}      plain HTTP for a load balancer backend set without re-encryption
# Clients never connect here directly: the load balancer terminates the public certificate
# and redirects port 80 to 443, and the host firewall admits only the LB subnet.

server {
	listen ${PORT} default_server;
	listen ${SSL_PORT} ssl default_server;
	server_name ${SERVER_NAME};

	ssl_certificate ${SSL_CERT_FILE};
	ssl_certificate_key ${SSL_CERT_KEY_FILE};
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
	ssl_prefer_server_ciphers off;
	ssl_session_timeout 1d;
	ssl_session_cache shared:H360TLS:10m;
	ssl_session_tickets off;

	client_max_body_size 12m;
	client_body_buffer_size 128k;
	large_client_header_buffers 8 16k;

	# Upstream timeouts; the realtime location below overrides them for long-lived sockets.
	proxy_connect_timeout 10s;
	proxy_send_timeout ${PROXY_TIMEOUT};
	proxy_read_timeout ${PROXY_TIMEOUT};

	if ($h360_denied) {
		return 403;
	}

	include includes/h360-security-headers.conf;

	# Container health check (/healthz) and nginx status for the host agent
	include includes/location_common.conf;

	# Load balancer health check: answered by the application, any Host accepted.
	location = /api/method/hostel360.api.health.liveness {
		access_log off;
		include includes/h360-proxy-headers.conf;
		proxy_pass http://h360_frontend;
	}

	# OTP login for students and parents
	location ~ ^/api/(?:v[12]/)?method/hostel360\.api\.auth\. {
		limit_req zone=h360_auth burst=${H360_AUTH_BURST} nodelay;
		include includes/h360-proxy.conf;
	}

	# Desk login, two-factor verification and password reset
	location ~ ^/api/(?:v[12]/)?method/(?:login|frappe\.core\.doctype\.user\.user\.(?:reset_password|update_password))$ {
		limit_req zone=h360_login burst=${H360_LOGIN_BURST} nodelay;
		include includes/h360-proxy.conf;
	}

	# The portal's service worker is served from /assets but controls the /hostel scope.
	location = /assets/hostel360/frontend/sw.js {
		include includes/h360-proxy.conf;
		# Server-level headers-more directives still apply; this one is added to them.
		more_set_headers "Service-Worker-Allowed: ${H360_SW_SCOPE}";
	}

	# Sign-in button script embedded by the institution website (deploy/integration/website):
	# loadable cross-origin, and readable with Subresource Integrity (crossorigin="anonymous").
	location ^~ /assets/hostel360/embed/ {
		include includes/h360-proxy.conf;
		more_set_headers "Cross-Origin-Resource-Policy: cross-origin";
		more_set_headers "Access-Control-Allow-Origin: *";
	}

	location /socket.io {
		include includes/h360-proxy.conf;
		proxy_read_timeout 3600s;
		proxy_send_timeout 3600s;
	}

	# Hostel website integration pages (PHP-FPM); see deploy/integration/website.
	location = /integration {
		return 301 /integration/;
	}

	location ^~ /integration/ {
		if ($h360_host_ok = 0) {
			return 421;
		}
		alias /var/www/hostel360/public/;
		index index.php;
		expires 1h;

		# PHP-FPM liveness and pool status, for the host agent (via docker exec) only
		location ~ ^/integration/(fpm-ping|fpm-status)$ {
			allow 127.0.0.1;
			deny all;
			access_log off;
			include fastcgi_params;
			fastcgi_param SCRIPT_NAME /$1;
			fastcgi_param SCRIPT_FILENAME /$1;
			fastcgi_pass h360_php;
		}

		location ~ ^/integration/((?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.php)$ {
			if ($h360_host_ok = 0) {
				return 421;
			}
			if (!-f /var/www/hostel360/public/$1) {
				return 404;
			}
			include fastcgi_params;
			fastcgi_param SCRIPT_FILENAME /var/www/hostel360/public/$1;
			fastcgi_param SCRIPT_NAME /integration/$1;
			fastcgi_param DOCUMENT_ROOT /var/www/hostel360/public;
			fastcgi_param HTTPS on;
			fastcgi_param HTTP_PROXY "";
			fastcgi_read_timeout 30s;
			fastcgi_pass h360_php;
		}

		# Anything else ending in .php (odd paths, traversal attempts) never reaches PHP.
		location ~ \.php$ {
			return 404;
		}
	}

	location / {
		include includes/h360-proxy.conf;
	}
}
