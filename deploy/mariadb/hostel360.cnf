# HyFib Hostel360: MariaDB 11.8 configuration for the production VM
# (OCI VM.Standard.A1.Flex, 8 OCPU / 16 GB, 400 GB block volume at VPU 10).
#
# Memory plan for the host: MariaDB 6-7 GB (this file), application workers 4 GB,
# Redis 1 GB, ClamAV, WAF, PHP-FPM and the OS in the remainder.
# Mounted read-only at /etc/mysql/conf.d/hostel360.cnf.

[mariadb]
# Frappe requires utf8mb4 everywhere
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
character-set-client-handshake = FALSE
innodb_default_row_format = dynamic
innodb_read_only_compressed = OFF

skip-name-resolve
max_connections = 250
max_allowed_packet = 256M
thread_cache_size = 64
table_open_cache = 4000
table_definition_cache = 4000
open_files_limit = 65535

# Per-connection buffers stay small; most Frappe queries are indexed point reads.
sort_buffer_size = 2M
join_buffer_size = 2M
read_rnd_buffer_size = 1M
tmp_table_size = 64M
max_heap_table_size = 64M

# InnoDB. The buffer pool holds the whole working set for ~2,000 residents for years.
innodb_buffer_pool_size = 6G
innodb_log_file_size = 1G
innodb_log_buffer_size = 64M
innodb_flush_log_at_trx_commit = 1
# A balanced block volume of 400 GB sustains roughly 24,000 IOPS.
innodb_io_capacity = 4000
innodb_io_capacity_max = 8000
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_lock_wait_timeout = 50

query_cache_type = 0
query_cache_size = 0
performance_schema = OFF

# Slow queries (> 1 s) for the monthly performance review. Relative paths are inside the
# data directory (/srv/hostel360/mariadb on the host), which the image keeps owned by the
# mysql user; logrotate on the host rotates the file.
slow_query_log = ON
slow_query_log_file = slow.log
long_query_time = 1
log_slow_verbosity = query_plan

# Binary log for point-in-time recovery between the nightly backups. The binlog files
# (mariadb-bin.*) are part of the nightly file backup; seven days are kept on disk.
server_id = 1
log_bin = mariadb-bin
log_bin_index = mariadb-bin.index
binlog_format = ROW
binlog_row_image = FULL
binlog_expire_logs_seconds = 604800
max_binlog_size = 256M
sync_binlog = 1

# Client programs inside the container (backups run mariadb-dump there)
[client]
default-character-set = utf8mb4
