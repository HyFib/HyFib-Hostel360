#!/bin/bash
# Gunicorn for the Frappe backend.
#
# Sizing for the A1.Flex 8 OCPU / 16 GB host: 6 workers x 4 threads = 24 requests in flight.
# At the 150 req/s peak of 1,500 portal users that holds while the average request takes
# under about 160 ms (24 / 150 s). This is the sizing assumption; tests/load (profile "load"
# on the staging stack) is the measurement, and its results in tests/load/results decide
# whether GUNICORN_WORKERS / GUNICORN_THREADS in stack.env need raising.
# --preload shares the imported code between workers; max-requests recycles workers
# gradually so slow memory growth never accumulates.
set -Eeuo pipefail

: "${GUNICORN_WORKERS:=6}"
: "${GUNICORN_THREADS:=4}"
: "${GUNICORN_TIMEOUT:=120}"
: "${GUNICORN_GRACEFUL_TIMEOUT:=30}"
: "${GUNICORN_MAX_REQUESTS:=5000}"
: "${GUNICORN_MAX_REQUESTS_JITTER:=500}"
: "${GUNICORN_BIND:=0.0.0.0:8000}"

echo "h360-backend: gunicorn ${GUNICORN_WORKERS} workers x ${GUNICORN_THREADS} threads on ${GUNICORN_BIND}" >&2

exec /home/frappe/frappe-bench/env/bin/gunicorn \
	--chdir=/home/frappe/frappe-bench/sites \
	--bind="${GUNICORN_BIND}" \
	--workers="${GUNICORN_WORKERS}" \
	--threads="${GUNICORN_THREADS}" \
	--worker-class=gthread \
	--worker-tmp-dir=/dev/shm \
	--timeout="${GUNICORN_TIMEOUT}" \
	--graceful-timeout="${GUNICORN_GRACEFUL_TIMEOUT}" \
	--max-requests="${GUNICORN_MAX_REQUESTS}" \
	--max-requests-jitter="${GUNICORN_MAX_REQUESTS_JITTER}" \
	--keep-alive=5 \
	--limit-request-line=8190 \
	--preload \
	frappe.app:application
