# Hostel360 frontend vhost (rendered by h360-frontend with envsubst).
#
# Request path: OCI Load Balancer -> WAF (ModSecurity/CRS, TLS, headers, rate limits)
#               -> this nginx -> gunicorn (backend) / socket.io (websocket)
#
# Only the WAF can reach this server, so the client address it forwards is trusted.

upstream h360_backend {
	server ${BACKEND} fail_timeout=0;
	keepalive 32;
}

upstream h360_socketio {
	server ${SOCKETIO} fail_timeout=0;
}

server {
	listen ${FRONTEND_PORT} default_server;
	server_name ${SITE_NAME};
	root /home/frappe/frappe-bench/sites;
	absolute_redirect off;

	set_real_ip_from ${UPSTREAM_REAL_IP_ADDRESS};
	real_ip_header X-Forwarded-For;
	real_ip_recursive on;

	client_max_body_size ${CLIENT_MAX_BODY_SIZE};
	client_body_buffer_size 128k;
	client_header_buffer_size 4k;
	large_client_header_buffers 8 16k;
	keepalive_timeout 65;

	proxy_buffer_size 128k;
	proxy_buffers 8 256k;
	proxy_busy_buffers_size 256k;

	gzip on;
	gzip_vary on;
	gzip_proxied any;
	gzip_comp_level 5;
	gzip_min_length 512;
	gzip_types
		application/javascript
		application/json
		application/manifest+json
		application/xml
		font/opentype
		image/svg+xml
		text/css
		text/javascript
		text/plain
		text/xml;

	location /assets/ {
		try_files $uri =404;
		add_header Cache-Control "public, max-age=3600" always;

		# esbuild bundles and the portal build carry content hashes in their names
		location ~ ^/assets/[^/]+/dist/ {
			try_files $uri =404;
			add_header Cache-Control "public, max-age=31536000, immutable" always;
		}
		location ~ ^/assets/hostel360/frontend/assets/ {
			try_files $uri =404;
			add_header Cache-Control "public, max-age=31536000, immutable" always;
		}

		# The service worker and the web manifest must be revalidated on every load so a
		# new portal release reaches installed apps without waiting for a cache to expire.
		location = /assets/hostel360/frontend/sw.js {
			try_files $uri =404;
			add_header Cache-Control "no-cache" always;
		}
		location ~ \.webmanifest$ {
			types { }
			default_type application/manifest+json;
			try_files $uri =404;
			add_header Cache-Control "no-cache" always;
		}
	}

	# Private files: Frappe checks permission and answers with X-Accel-Redirect
	location ~ ^/protected/(.*) {
		internal;
		try_files /${SITE_NAME}/$1 =404;
	}

	location /socket.io {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
		proxy_set_header Origin https://${SITE_NAME};
		proxy_set_header Host $host;
		proxy_read_timeout 3600s;
		proxy_send_timeout 3600s;

		proxy_pass http://h360_socketio;
	}

	location / {
		rewrite ^(.+)/$ $1 permanent;
		rewrite ^(.+)/index\.html$ $1 permanent;
		rewrite ^(.+)\.html$ $1 permanent;

		# Uploaded markup is downloaded, never rendered in the site's origin.
		location ~ ^/files/.*\.(htm|html|svg|xml)$ {
			add_header Content-Disposition "attachment" always;
			add_header X-Content-Type-Options "nosniff" always;
			try_files /${SITE_NAME}/public/$uri @webserver;
		}

		try_files /${SITE_NAME}/public/$uri @webserver;
	}

	location @webserver {
		proxy_http_version 1.1;
		proxy_set_header Connection "";
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
		proxy_set_header Host $host;
		proxy_set_header X-Use-X-Accel-Redirect True;
		proxy_read_timeout ${PROXY_READ_TIMEOUT};
		proxy_send_timeout ${PROXY_READ_TIMEOUT};
		proxy_redirect off;

		proxy_pass http://h360_backend;
	}

	location = /nginx-health {
		access_log off;
		allow 127.0.0.1;
		deny all;
		default_type text/plain;
		return 200 "ok\n";
	}
}
