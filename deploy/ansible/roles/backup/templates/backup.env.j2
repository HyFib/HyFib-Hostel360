# {{ ansible_managed }}
RESTIC_REPOSITORY=rclone:oos:{{ h360_backup_bucket }}/{{ h360_backup_repository_path }}
RESTIC_PASSWORD_FILE={{ h360_config_dir }}/secrets/restic_password
RESTIC_CACHE_DIR=/var/cache/restic
RESTIC_COMPRESSION=auto

RCLONE_CONFIG_OOS_TYPE=oracleobjectstorage
RCLONE_CONFIG_OOS_PROVIDER=instance_principal_auth
RCLONE_CONFIG_OOS_NAMESPACE={{ h360_backup_namespace }}
RCLONE_CONFIG_OOS_COMPARTMENT={{ h360_compartment_id }}
RCLONE_CONFIG_OOS_REGION={{ h360_backup_region }}

H360_BACKUP_KEEP_DAILY={{ h360_backup_keep_daily }}
H360_BACKUP_KEEP_WEEKLY={{ h360_backup_keep_weekly }}
H360_BACKUP_KEEP_MONTHLY={{ h360_backup_keep_monthly }}
H360_BACKUP_CHECK_SUBSET=5%
H360_BACKUP_EXTRA_PATHS="/var/log/audit /var/log/auth.log /var/log/syslog /var/log/sudo.log /var/log/fail2ban.log /var/log/ufw.log"

H360_BLOCK_VOLUME_ID={{ h360_block_volume_id }}
H360_COMPARTMENT_ID={{ h360_compartment_id }}
H360_SNAPSHOT_KEEP_DAYS={{ h360_snapshot_keep_days }}
