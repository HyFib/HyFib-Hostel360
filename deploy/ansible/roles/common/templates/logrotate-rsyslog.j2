# {{ ansible_managed }}
# System logs: daily, {{ h360_log_retention_days }} days (CERT-In).
/var/log/syslog
/var/log/mail.log
/var/log/kern.log
/var/log/auth.log
/var/log/user.log
/var/log/cron.log
/var/log/sudo.log
{
	daily
	rotate {{ h360_log_retention_days }}
	missingok
	notifempty
	compress
	delaycompress
	dateext
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}
