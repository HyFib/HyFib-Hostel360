# {{ ansible_managed }}
# Time from NIC (samay1/samay2.nic.in) and NPL (time.nplindia.org), as required by the
# CERT-In directions of 28 April 2022 for log timestamps.
{% for server in h360_ntp_servers %}
server {{ server }} iburst
{% endfor %}

driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync
makestep 1 3
leapsectz right/UTC
