# {{ ansible_managed }}
H360_HOST_LABEL="{{ h360_host_label }}"
H360_SITE_NAME="{{ h360_site_name }}"
H360_PUBLIC_URL="{{ h360_public_url }}"

H360_INGEST_URL="https://{{ h360_site_name }}:8443/api/method/hostel360.api.ops.ingest"
H360_INGEST_RESOLVE="{{ h360_site_name }}:8443:127.0.0.1"
H360_INGEST_CACERT="{{ h360_config_dir }}/waf/tls/server.crt"
H360_INGEST_SECRET="{{ vault_h360_ingest_secret }}"
H360_ONS_TOPIC_ID="{{ h360_ons_topic_id }}"

H360_COMPOSE_PROJECT=hostel360
H360_COMPOSE_FILE=/opt/hostel360/deploy/compose/compose.yml
H360_STACK_ENV="{{ h360_config_dir }}/stack.env"
H360_DATA_DIR="{{ h360_data_dir }}"
