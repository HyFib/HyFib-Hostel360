# {{ ansible_managed }}
# HyFib Hostel360 stack settings (docker compose --env-file). h360-deploy changes
# H360_IMAGE_TAG; everything else is managed by Ansible (roles/app).
H360_IMAGE={{ h360_image }}
H360_IMAGE_TAG={{ h360_effective_tag }}

SITE_NAME={{ h360_site_name }}
PUBLIC_URL={{ h360_public_url }}

H360_DATA_DIR={{ h360_data_dir }}
H360_CONFIG_DIR={{ h360_config_dir }}
H360_RUNTIME_DIR=/run/hostel360

LB_SUBNET_CIDR={{ h360_lb_subnet_cidr }}
WAF_BIND_ADDRESS={{ h360_waf_bind_address }}
WAF_HTTPS_PORT=8443
WAF_HTTP_PORT=8080
WAF_RULE_ENGINE={{ h360_waf_rule_engine }}
WAF_AUTH_RATE={{ h360_waf_auth_rate }}
WAF_AUTH_BURST={{ h360_waf_auth_burst }}
WAF_LOGIN_RATE={{ h360_waf_login_rate }}
WAF_LOGIN_BURST={{ h360_waf_login_burst }}

GUNICORN_WORKERS={{ h360_gunicorn_workers }}
GUNICORN_THREADS={{ h360_gunicorn_threads }}
GUNICORN_TIMEOUT=120

H360_EDGE_SUBNET=172.30.20.0/24
H360_INTERNAL_SUBNET=172.30.10.0/24
H360_PHP_SUBNET=172.30.30.0/24

INSTITUTION_NAME={{ h360_institution_name }}
INSTITUTION_SHORT_NAME={{ h360_institution_short_name }}
SUPPORT_PHONE={{ h360_support_phone }}
SUPPORT_EMAIL={{ h360_support_email }}
HOSTEL_WEBSITE_ORIGINS={{ h360_hostel_website_origins | join(',') }}
