# HyFib Hostel360 stack settings (example).
#
# On the server this file is /etc/hostel360/stack.env (mode 0600), written by the Ansible
# "app" role from inventory variables; h360-deploy updates H360_IMAGE_TAG. No secrets live
# here: the MariaDB root password is a file under ${H360_CONFIG_DIR}/secrets.

# Application image in OCI Registry (Hyderabad) and the exact tag to run. Never "latest".
H360_IMAGE=ap-hyderabad-1.ocir.io/axabcdefghij/hostel360
H360_IMAGE_TAG=1.0.0-94a56ce3e54a

# Site served by the stack and its public URL (the load balancer's certificate name)
SITE_NAME=hostel.accet.ac.in
PUBLIC_URL=https://hostel.accet.ac.in

# Host paths: block volume, configuration, runtime sockets
H360_DATA_DIR=/srv/hostel360
H360_CONFIG_DIR=/etc/hostel360
H360_RUNTIME_DIR=/run/hostel360

# Load balancer subnet: the only source trusted for X-Forwarded-For at the WAF
LB_SUBNET_CIDR=10.20.1.0/24

# Address the WAF ports (8443 TLS, 8080 plain) are published on; the private IP of the VM
# narrows it further than the host firewall already does.
WAF_BIND_ADDRESS=0.0.0.0
# Host ports; the load balancer backend set and the host firewall use the same numbers.
WAF_HTTPS_PORT=8443
WAF_HTTP_PORT=8080

# WAF rule engine: On (blocking) or DetectionOnly (log only, for tuning)
WAF_RULE_ENGINE=On

# Per-address limits for sign-in endpoints. The campus egress addresses are exempt (Ansible
# h360_campus_egress_cidrs -> ${H360_CONFIG_DIR}/waf/lists/rate-exempt.conf); do not raise
# these to make room for the campus.
WAF_AUTH_RATE=120r/m
WAF_AUTH_BURST=60
WAF_LOGIN_RATE=30r/m
WAF_LOGIN_BURST=20

# Gunicorn: 6 workers x 4 threads
GUNICORN_WORKERS=6
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Container networks (change only if they collide with the VCN ranges)
H360_EDGE_SUBNET=172.30.20.0/24
H360_INTERNAL_SUBNET=172.30.10.0/24
H360_PHP_SUBNET=172.30.30.0/24

# Public egress addresses of the campus network, comma separated (Ansible:
# h360_campus_egress_cidrs). Not used by compose: h360-site-init adds them to Messaging
# Settings > Trusted Networks so the OTP per-address limit does not apply to the campus.
CAMPUS_EGRESS_CIDRS=203.0.113.16/29

# Hostel website integration pages (/integration/)
INSTITUTION_NAME=Alagappa Chettiar Government College of Engineering and Technology Hostels
INSTITUTION_SHORT_NAME=ACGCET
SUPPORT_PHONE=+91 96060 60596
SUPPORT_EMAIL=support@hyfib.com
# Origins of the official hostel website allowed to read /integration/links.php
HOSTEL_WEBSITE_ORIGINS=https://www.accet.ac.in
