#!/usr/bin/env bash
# OCI block volume backup of the Hostel360 data volume (/srv/hostel360).
#
#   h360-snapshot [--reason NAME] [--wait]    create an incremental volume backup
#   h360-snapshot --prune                     delete this script's backups older than
#                                             H360_SNAPSHOT_KEEP_DAYS (default 14)
#
# A volume backup captures the volume at the moment it is requested, so the caller can
# carry on (a deployment, a restore) while OCI copies the data in the background. The
# volume's own backup policy (Terraform storage.tf) keeps the scheduled backups; this script
# only manages the ad-hoc ones it creates, recognised by their freeform tags.
#
# Authentication is the instance principal (dynamic group policy in iam.tf).
set -Eeuo pipefail

# shellcheck source=deploy/host/bin/h360-lib.sh
source /usr/local/lib/hostel360/h360-lib.sh
h360_init h360-snapshot
h360_require_root
h360_load_env "${H360_CONFIG_DIR}/agent.env"
h360_load_env "${H360_CONFIG_DIR}/backup.env"
h360_require_cmd oci jq curl

reason=manual
wait=0
prune=0
while [[ $# -gt 0 ]]; do
	case "$1" in
		--reason)
			reason="${2:?--reason needs a value}"
			shift
			;;
		--wait) wait=1 ;;
		--prune) prune=1 ;;
		-h | --help)
			sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		*) die "unknown option $1" ;;
	esac
	shift
done
[[ "${reason}" =~ ^[a-z0-9-]{1,40}$ ]] || die "reason must be lowercase letters, digits and dashes"

h360_lock snapshot 900

export OCI_CLI_AUTH=instance_principal
: "${H360_BLOCK_VOLUME_ID:?H360_BLOCK_VOLUME_ID is not set in backup.env}"
: "${H360_SNAPSHOT_KEEP_DAYS:=14}"
host="$(h360_host)"

compartment_id() {
	if [[ -n "${H360_COMPARTMENT_ID:-}" ]]; then
		printf '%s' "${H360_COMPARTMENT_ID}"
		return
	fi
	curl -fsS --max-time 5 -H 'Authorization: Bearer Oracle' \
		http://169.254.169.254/opc/v2/instance/ | jq -r '.compartmentId'
}

prune_backups() {
	local cutoff compartment
	cutoff="$(date -u -d "-${H360_SNAPSHOT_KEEP_DAYS} days" +%Y-%m-%dT%H:%M:%S)"
	compartment="$(compartment_id)"
	oci bv backup list --compartment-id "${compartment}" --volume-id "${H360_BLOCK_VOLUME_ID}" --all --output json |
		jq -r --arg cutoff "${cutoff}" '.data[]
			| select(.["freeform-tags"]["created-by"] == "h360-snapshot")
			| select(.["lifecycle-state"] == "AVAILABLE")
			| select(.["time-created"][0:19] < $cutoff)
			| .id' |
		while IFS= read -r backup; do
			log_info "deleting volume backup ${backup}"
			oci bv backup delete --volume-backup-id "${backup}" --force >/dev/null ||
				log_warn "could not delete ${backup}"
		done
}

if [[ "${prune}" == 1 ]]; then
	prune_backups
	exit 0
fi

name="hostel360-${reason}-$(date +%Y%m%d-%H%M%S)"
tags="$(jq -cn --arg reason "${reason}" --arg host "${host}" \
	'{"application": "hostel360", "created-by": "h360-snapshot", "reason": $reason, "host": $host}')"
args=(bv backup create --volume-id "${H360_BLOCK_VOLUME_ID}" --type INCREMENTAL
	--display-name "${name}" --freeform-tags "${tags}" --output json)
[[ "${wait}" == 1 ]] && args+=(--wait-for-state AVAILABLE --max-wait-seconds 7200)

started_at="$(h360_now_iso)"
log_info "requesting volume backup ${name}"
if ! result="$(oci "${args[@]}" 2>&1)"; then
	h360_report "$(jq -cn --arg message "Volume backup ${name} failed: ${result:0:500}" --arg started "${started_at}" \
		--arg finished "$(h360_now_iso)" --arg host "${host}" \
		'{type: "backup", source: "Host Agent", backup_type: "Snapshot", status: "Failed", started_at: $started,
		  finished_at: $finished, repository: "oci-block-volume-backup", host: $host, message: $message}')"
	die "volume backup request failed: ${result:0:500}"
fi
backup_id="$(jq -r '.data.id' <<<"${result}")"
state="$(jq -r '.data["lifecycle-state"]' <<<"${result}")"
h360_report "$(jq -cn --arg id "${backup_id}" --arg message "Volume backup ${name} (${reason}) ${state}." \
	--arg started "${started_at}" --arg finished "$(h360_now_iso)" --arg host "${host}" \
	'{type: "backup", source: "Host Agent", backup_type: "Snapshot", status: "Success", started_at: $started,
	  finished_at: $finished, snapshot_id: $id, repository: "oci-block-volume-backup", host: $host, message: $message}')"
log_notice "volume backup ${backup_id} ${state}"
printf '%s\n' "${backup_id}"

prune_backups || log_warn "pruning old volume backups failed"
