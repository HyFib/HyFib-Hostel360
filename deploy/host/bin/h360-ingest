#!/usr/bin/env bash
# Send one JSON message to the Hostel360 ingest API (hostel360.api.ops.ingest).
#
#   h360-ingest <file>        message from a file
#   h360-ingest -             message from standard input
#   h360-ingest --flush       retry spooled messages (the agent does this every run)
#
# Exit status: 0 delivered, 1 kept in the spool for a later attempt, 2 rejected for good.
#
# Each request is signed with the shared ingest secret (Ops Alert Settings):
#   X-H360-Timestamp: <unix seconds>
#   X-H360-Signature: hex(HMAC-SHA256(secret, "<timestamp>.<body>"))
#
# Every message gets a message_id (a random UUID) the first time it is seen here, before it
# is sent or spooled, and keeps it on every retry. A retry is re-signed with a new timestamp,
# so the signature alone cannot tell the server it is a repeat; the message_id can. If an
# earlier attempt timed out here but did commit on the server, the retry is answered 409
# and counts as delivered instead of being processed twice.
#
# Answers: 2xx and 409 delivered; 400, 413 and 422 rejected for good (the message is
# dropped and the reason is in Hostel360's Error Log); anything else, including 401/403
# (secret or clock), 417, 429 and 5xx, is retried later.
#
# Messages that cannot be delivered (application down, network) are kept in the spool and
# re-signed on the next attempt: for 24 hours (H360_SPOOL_MAX_AGE_MINUTES), at most 2000 of
# them (H360_SPOOL_MAX_FILES), oldest dropped first. Uptime probe samples (type "metrics",
# source "Uptime Probe") are the record of an outage itself, so they are kept apart from
# that limit for 35 days (H360_SPOOL_KEEP_DAYS, at most H360_SPOOL_KEEP_MAX_FILES files):
# the monthly availability figure then shows a long outage as measured downtime rather than
# as minutes nobody watched. A critical alert that cannot be delivered is also published to
# the OCI Notifications topic, when one is configured, so HyFib still hears about it while
# the application itself is unavailable.
set -Eeuo pipefail

# shellcheck source=deploy/host/bin/h360-lib.sh
source /usr/local/lib/hostel360/h360-lib.sh
h360_init h360-ingest
h360_load_env "${H360_CONFIG_DIR}/agent.env"
h360_require_cmd curl jq python3

: "${H360_INGEST_URL:?H360_INGEST_URL is not set in agent.env}"
: "${H360_INGEST_SECRET:?H360_INGEST_SECRET is not set in agent.env}"
: "${H360_SPOOL_MAX_AGE_MINUTES:=1440}"
: "${H360_SPOOL_MAX_FILES:=2000}"
: "${H360_SPOOL_KEEP_DAYS:=35}"
: "${H360_SPOOL_KEEP_MAX_FILES:=12000}"
# A long backlog is worked off over several runs instead of holding the lock for an hour.
: "${H360_SPOOL_FLUSH_SECONDS:=240}"
# How long a message waits for a flush in progress before it is spooled behind it
: "${H360_INGEST_LOCK_WAIT:=60}"
for setting in H360_SPOOL_MAX_AGE_MINUTES H360_SPOOL_MAX_FILES H360_SPOOL_KEEP_DAYS \
	H360_SPOOL_KEEP_MAX_FILES H360_SPOOL_FLUSH_SECONDS H360_INGEST_LOCK_WAIT; do
	[[ "${!setting}" =~ ^[1-9][0-9]{0,6}$ ]] || die "${setting} must be a positive whole number"
done

spool="${H360_SPOOL_DIR}/ingest"
mkdir -p "${spool}"
chmod 0700 "${spool}"
# Spool file names: <yyyymmddHHMMSS>-<random>.json, and <...>.keep.json for probe samples.
# Sorting by name keeps the order in which messages were first created.
keep_suffix=.keep.json

sign() {
	# sign <timestamp> <file>: hex HMAC-SHA256 of "<timestamp>.<body>"; the secret is passed
	# in the environment, never on a command line.
	H360_HMAC_KEY="${H360_INGEST_SECRET}" python3 - "$1" "$2" <<'PY'
import hashlib
import hmac
import os
import sys

with open(sys.argv[2], "rb") as handle:
	body = handle.read()
key = os.environ["H360_HMAC_KEY"].encode()
print(hmac.new(key, sys.argv[1].encode() + b"." + body, hashlib.sha256).hexdigest())
PY
}

new_message_id() {
	local id=""
	if [[ -r /proc/sys/kernel/random/uuid ]]; then
		id="$(cat /proc/sys/kernel/random/uuid)"
	fi
	if [[ ! "${id}" =~ ^[0-9a-f-]{36}$ ]]; then
		id="$(python3 -c 'import uuid; print(uuid.uuid4())')"
	fi
	printf '%s' "${id}"
}

with_message_id() {
	# with_message_id <file>: give the message a message_id unless it already has a valid
	# one (compact JSON: the signature covers exactly the bytes sent). The file's time is
	# kept, because the spool's age limits are measured from it.
	local file="$1" tmp
	if jq -e '(.message_id // "") | type == "string" and test("^[A-Za-z0-9._:-]{8,100}$")' "${file}" >/dev/null 2>&1; then
		return 0
	fi
	if jq -e 'has("message_id") and .message_id != null and .message_id != ""' "${file}" >/dev/null 2>&1; then
		log_error "message_id in ${file##*/} must be 8 to 100 letters, digits or . _ : -"
		return 2
	fi
	tmp="$(mktemp "${file%/*}/.id-XXXXXX")"
	jq -c --arg id "$(new_message_id)" '. + {message_id: $id}' "${file}" >"${tmp}" || {
		rm -f -- "${tmp}"
		return 2
	}
	touch -r "${file}" -- "${tmp}"
	mv -f -- "${tmp}" "${file}"
}

post() {
	# post <file>: 0 delivered (or already delivered), 1 retry later, 2 rejected for good
	local file="$1" timestamp signature status attempt
	local -a tls=()
	[[ -n "${H360_INGEST_RESOLVE:-}" ]] && tls+=(--resolve "${H360_INGEST_RESOLVE}")
	[[ -n "${H360_INGEST_CACERT:-}" ]] && tls+=(--cacert "${H360_INGEST_CACERT}")

	timestamp="$(date +%s)"
	signature="$(sign "${timestamp}" "${file}")"
	for attempt in 1 2; do
		status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
			--max-time 15 --connect-timeout 5 "${tls[@]}" \
			--header 'Content-Type: application/json' \
			--header "X-H360-Timestamp: ${timestamp}" \
			--header "X-H360-Signature: ${signature}" \
			--data-binary "@${file}" \
			"${H360_INGEST_URL}" 2>/dev/null || true)"
		case "${status}" in
			2?? | 409) return 0 ;;
			400 | 413 | 422)
				log_error "ingest rejected a message (HTTP ${status}); see Error Log in Hostel360"
				return 2
				;;
			401 | 403)
				log_error "ingest refused the signature (HTTP ${status}); check H360_INGEST_SECRET and the clock"
				return 1
				;;
		esac
		[[ "${attempt}" -lt 2 ]] && sleep 2
	done
	log_warn "ingest unreachable (last HTTP status '${status:-none}')"
	return 1
}

notify_oci() {
	# Fallback for critical alerts while the application cannot take them.
	local file="$1" title body
	[[ -n "${H360_ONS_TOPIC_ID:-}" ]] || return 0
	command -v oci >/dev/null 2>&1 || return 0
	[[ "$(jq -r '.type // ""' "${file}")" == "alert" ]] || return 0
	[[ "$(jq -r '.severity // ""' "${file}")" == "Critical" ]] || return 0
	title="$(jq -r '"[Hostel360] " + (.title // .key)' "${file}" | cut -c1-120)"
	body="$(jq -r '"Host: \(.details.host // "-")\nKey: \(.key)\n\n\(.description // "")\n\nThe Hostel360 application did not accept this alert, so it was sent directly from the server."' "${file}")"
	if oci ons message publish --auth instance_principal --topic-id "${H360_ONS_TOPIC_ID}" \
		--title "${title}" --body "${body}" >/dev/null 2>&1; then
		log_notice "critical alert published to OCI Notifications"
	else
		log_warn "OCI Notifications publish failed as well"
	fi
}

is_probe_metrics() {
	jq -e '.type == "metrics" and .source == "Uptime Probe"' "$1" >/dev/null 2>&1
}

drop_oldest() {
	# drop_oldest <find name test...>: delete the 100 oldest spooled files matching the test
	find "${spool}" -maxdepth 1 -type f "$@" -printf '%T@ %p\n' | sort -n | head -n 100 |
		cut -d' ' -f2- | xargs -r rm -f --
}

spool_message() {
	# spool_message <file>: keep a copy for a later attempt. Written under a temporary name
	# and renamed, so a flush running at the same time never reads half a message.
	local file="$1" count suffix=.json target tmp
	if is_probe_metrics "${file}"; then
		suffix="${keep_suffix}"
		count="$(find "${spool}" -maxdepth 1 -type f -name "*${keep_suffix}" | wc -l)"
		if [[ "${count}" -ge "${H360_SPOOL_KEEP_MAX_FILES}" ]]; then
			log_error "ingest spool holds ${count} uptime probe batches; dropping the oldest"
			drop_oldest -name "*${keep_suffix}"
		fi
	else
		count="$(find "${spool}" -maxdepth 1 -type f -name '*.json' ! -name "*${keep_suffix}" | wc -l)"
		if [[ "${count}" -ge "${H360_SPOOL_MAX_FILES}" ]]; then
			log_error "ingest spool is full (${count} messages); dropping the oldest"
			drop_oldest -name '*.json' ! -name "*${keep_suffix}"
		fi
	fi
	tmp="$(mktemp "${spool}/.new-XXXXXX")"
	cp -- "${file}" "${tmp}"
	target="${spool}/$(date +%Y%m%d%H%M%S)-$(new_message_id | cut -c1-8)${suffix}"
	mv -f -- "${tmp}" "${target}"
}

prune_spool() {
	find "${spool}" -maxdepth 1 -type f -name '*.json' ! -name "*${keep_suffix}" \
		-mmin "+${H360_SPOOL_MAX_AGE_MINUTES}" -delete
	find "${spool}" -maxdepth 1 -type f -name "*${keep_suffix}" -mtime "+${H360_SPOOL_KEEP_DAYS}" -delete
	# Leftovers of a copy that was interrupted
	find "${spool}" -maxdepth 1 -type f -name '.*' -mmin +60 -delete
}

flush_spool() {
	# 0 everything delivered, 1 stopped at a message that has to wait, 3 out of time
	local file result deadline
	prune_spool
	deadline=$((SECONDS + H360_SPOOL_FLUSH_SECONDS))
	while IFS= read -r file; do
		[[ -f "${file}" ]] || continue
		if ((SECONDS >= deadline)); then
			log_notice "ingest spool not empty yet; the next run continues"
			return 3
		fi
		result=0
		# Messages spooled by an older version of this script have no message_id yet.
		with_message_id "${file}" || result=$?
		[[ "${result}" == 0 ]] && { post "${file}" || result=$?; }
		case "${result}" in
			0 | 2) rm -f -- "${file}" ;;
			*) return 1 ;;
		esac
	done < <(find "${spool}" -maxdepth 1 -type f -name '*.json' | sort)
	return 0
}

if [[ "${1:-}" == "--flush" ]]; then
	# Another run is already flushing (or sending); it will get there.
	h360_try_lock ingest "${H360_INGEST_LOCK_WAIT}" || exit 0
	result=0
	flush_spool || result=$?
	[[ "${result}" == 1 ]] && exit 1
	exit 0
fi

source_file="${1:--}"
message="$(mktemp)"
trap 'rm -f -- "${message}" "${message}.c"' EXIT
if [[ "${source_file}" == "-" ]]; then
	cat >"${message}"
else
	cp -- "${source_file}" "${message}"
fi
jq -e 'type == "object" and has("type")' "${message}" >/dev/null 2>&1 || die "message is not a JSON object with a type"
# Compact form: the signature covers exactly the bytes sent.
jq -c . "${message}" >"${message}.c" && mv -f -- "${message}.c" "${message}"
with_message_id "${message}" || die "message rejected before sending"

if ! h360_try_lock ingest "${H360_INGEST_LOCK_WAIT}"; then
	# A long flush is running. Keep the message for it (or the next run) rather than losing
	# it; the application is evidently reachable, so OCI Notifications is not needed.
	spool_message "${message}"
	log_notice "ingest busy; message spooled for the next attempt"
	exit 1
fi

# Older messages go first so the server sees events in order. When even those cannot be
# delivered the application is down: keep this one too instead of waiting on it again.
result=0
flushed=0
flush_spool || flushed=$?
case "${flushed}" in
	0) post "${message}" || result=$? ;;
	3) result=3 ;;
	*) result=1 ;;
esac
case "${result}" in
	0) exit 0 ;;
	2) exit 2 ;;
	3)
		# Behind a backlog that is still being delivered: queue it in order.
		spool_message "${message}"
		exit 1
		;;
	*)
		spool_message "${message}"
		notify_oci "${message}"
		exit 1
		;;
esac
