# /etc/hostel360/agent.env: settings for the Hostel360 host scripts (h360-agent,
# h360-uptime-probe, h360-ingest, h360-backup reporting, h360-deploy).
# Owner root, mode 0600. Written by the Ansible "monitoring" role from inventory variables.
# The file is sourced by bash: quote values that contain spaces.

# Name this server reports under (Ops Alert keys, metric host)
H360_HOST_LABEL=hostel360-prod-hyd

# Public portal URL (load balancer) and site name
H360_SITE_NAME=hostel.accet.ac.in
H360_PUBLIC_URL=https://hostel.accet.ac.in

# Ingest API reached locally through the WAF: no dependency on the load balancer or DNS.
# --resolve pins the site name to this host; the internal WAF certificate is the CA.
H360_INGEST_URL=https://hostel.accet.ac.in:8443/api/method/hostel360.api.ops.ingest
H360_INGEST_RESOLVE=hostel.accet.ac.in:8443:127.0.0.1
H360_INGEST_CACERT=/etc/hostel360/waf/tls/server.crt
# Must equal "Ingest Secret" in Hostel360 > Ops Alert Settings
H360_INGEST_SECRET=change-me-to-a-64-character-random-hex-string

# Fallback for critical alerts while the application is down: OCI Notifications topic
# (terraform output notification_topic_id). Leave empty to disable.
H360_ONS_TOPIC_ID=

# Where this host reaches the WAF for smoke checks after a deployment or restore
# (address or host name, and port; the port defaults to WAF_HTTPS_PORT of stack.env)
H360_LOCAL_WAF_ADDRESS=127.0.0.1
H360_LOCAL_WAF_PORT=8443

# Stack
H360_COMPOSE_PROJECT=hostel360
H360_COMPOSE_FILE=/opt/hostel360/deploy/compose/compose.yml
H360_STACK_ENV=/etc/hostel360/stack.env
H360_DATA_DIR=/srv/hostel360

# Thresholds (defaults shown)
H360_DISK_WARN=80
H360_DISK_CRIT=90
H360_INODE_WARN=80
H360_MEM_WARN=90
H360_MEM_CRIT=97
H360_SWAP_WARN=50
H360_CPU_WARN=90
H360_LOAD_WARN_PER_CPU=2
H360_TLS_WARN_DAYS=21
H360_TLS_CRIT_DAYS=7
H360_CLAMAV_SIG_WARN_HOURS=48
H360_CLAMAV_SIG_CRIT_HOURS=96
H360_WAF_BLOCK_ALERT=300
H360_BAN_ALERT=25
H360_RESTART_ALERT=3

# Uptime probe
H360_PROBE_BATCH=5
H360_PROBE_FAIL_ALERT=3
H360_PROBE_TIMEOUT=10
