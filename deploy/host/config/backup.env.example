# /etc/hostel360/backup.env: restic repository and OCI settings for h360-backup,
# h360-restore, h360-restore-test, h360-snapshot and h360-deploy.
# Owner root, mode 0600. Written by the Ansible "backup" role.

# restic repository in the Mumbai bucket, reached through rclone's Object Storage backend
RESTIC_REPOSITORY=rclone:oos:hostel360-backups-mumbai/restic
# Repository password (AES-256 key material). Keep a sealed copy with ACGCET as well:
# without it the backups cannot be read by anyone.
RESTIC_PASSWORD_FILE=/etc/hostel360/secrets/restic_password
RESTIC_CACHE_DIR=/var/cache/restic
RESTIC_COMPRESSION=auto

# rclone remote "oos": OCI Object Storage with instance principal authentication
RCLONE_CONFIG_OOS_TYPE=oracleobjectstorage
RCLONE_CONFIG_OOS_PROVIDER=instance_principal_auth
RCLONE_CONFIG_OOS_NAMESPACE=axabcdefghij
RCLONE_CONFIG_OOS_COMPARTMENT=ocid1.compartment.oc1..aaaaexample
RCLONE_CONFIG_OOS_REGION=ap-mumbai-1

# Retention (snapshots kept per kind)
H360_BACKUP_KEEP_DAILY=30
H360_BACKUP_KEEP_WEEKLY=12
H360_BACKUP_KEEP_MONTHLY=12
H360_BACKUP_CHECK_SUBSET=5%

# OCI block volume backups (h360-snapshot); terraform output data_volume_id
H360_BLOCK_VOLUME_ID=ocid1.volume.oc1.ap-hyderabad-1.example
H360_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaexample
H360_SNAPSHOT_KEEP_DAYS=14
