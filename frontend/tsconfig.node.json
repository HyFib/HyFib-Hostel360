{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2023"
		],
		"types": [
			"node"
		],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"vite.config.ts",
		"vitest.config.ts",
		"plugins/**/*.ts"
	]
}
